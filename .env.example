# PostgreSQL connection.
# Local dev: point both at the same local database.
# Neon: DATABASE_URL = pooled string (…-pooler.…neon.tech), DIRECT_URL = direct string.
DATABASE_URL="postgresql://user@localhost:5432/khulagrow"
DIRECT_URL="postgresql://user@localhost:5432/khulagrow"

# JWT signing secret — generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Where photo/document uploads are written.
# Local dev: ./uploads   Netlify/Lambda: /tmp/uploads (ephemeral — see README)
UPLOAD_DIR="./uploads"

# Yoco payments — R1,500/month subscription (see README "Payments" section).
# Secret key: Yoco Portal → Sell online → Payment Gateway (sk_test_… / sk_live_…)
YOCO_SECRET_KEY=""
# Returned when you register the webhook (whsec_…)
YOCO_WEBHOOK_SECRET=""
# Public origin for Yoco success/cancel redirects, e.g. https://khulagrow.smartpick.co.za
APP_URL="http://localhost:3000"
